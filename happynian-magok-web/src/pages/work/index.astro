---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { works, workImageStyle } from '@/data/works';
import { withBase } from '@/data/site';
import { breadcrumbSchema, withContext } from '@/lib/schema';

const path = '/work/';
const jsonLd = withContext([
  breadcrumbSchema([
    { name: '홈', path: '/' },
    { name: '작업', path },
  ]),
]);
---

<BaseLayout
  title="강윤의 작업 | 남자머리 텍스쳐컷·펌·탈색 사례 | Happynian Magok"
  description="강윤 디자이너가 진행한 남자머리 작업 사례입니다. 텍스쳐컷, 히피펌, 탈색·컬러 등 실제 작업을 확인해보세요."
  path={path}
  ogImage={works[0].heroImage.src}
  jsonLd={jsonLd}
>
  <div class="container work-index">
    <Breadcrumb items={[{ name: '홈', path: '/' }, { name: '작업' }]} />
    <p class="eyebrow"><span class="num">02</span> SELECTED WORK</p>
    <h1 class="section-title">강윤의 작업</h1>
    <p class="section-lede">
      실제로 진행한 작업입니다. 각 페이지에서 스타일의 특징과 상담 시 참고할 점을 볼 수
      있습니다.
    </p>

    <div class="work-index-grid">
      {
        works.map((work) => (
          <a class="work-index-card" href={withBase(`/work/${work.slug}/`)}>
            <div class="media">
              <Picture
                src={work.heroImage.src}
                alt={work.heroImage.alt}
                widths={[320, 560, 800]}
                sizes="(max-width: 860px) 44vw, 22vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                loading="lazy"
                style={workImageStyle(work.heroImage)}
              />
            </div>
            <p class="name">
              <span class="cap-num">{work.number}</span> {work.shortLabel}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .work-index {
    padding-block: 40px 96px;
  }

  .work-index-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .work-index-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-ivory-deep);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    margin: 12px 0 0;
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (min-width: 760px) {
    .work-index-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
